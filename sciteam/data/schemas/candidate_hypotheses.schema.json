{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/candidate_hypotheses.schema.json",
  "title": "CandidateHypotheses",
  "description": "Exit contract for hypothesis missions: 1-3 falsifiable candidates with grounding and smoke evidence.",
  "type": "object",
  "required": ["mission_id", "problem_id", "candidates"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "problem_id": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "statement", "falsification_criterion", "rationale"],
        "additionalProperties": false,
        "properties": {
          "hypothesis_id": { "type": "string", "minLength": 1 },
          "statement": {
            "type": "string",
            "minLength": 20,
            "description": "Precise, testable claim about the mechanism and expected effect."
          },
          "falsification_criterion": {
            "type": "string",
            "minLength": 10,
            "description": "What frozen-eval outcome would falsify this hypothesis."
          },
          "rationale": { "type": "string", "minLength": 10 },
          "grounding": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["citation_key"],
              "additionalProperties": false,
              "properties": {
                "citation_key": { "type": "string" },
                "claim": { "type": "string" },
                "source_url": { "type": "string" },
                "title": {
                  "type": "string",
                  "description": "Exact title of the resolved record; checked against the identifier by the grounding gate."
                },
                "arxiv_id": { "type": "string", "pattern": "^\\d{4}\\.\\d{4,5}$" },
                "doi": { "type": "string", "pattern": "^10\\." }
              }
            }
          },
          "smoke_check": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "performed": { "type": "boolean" },
              "summary": { "type": "string" },
              "artifact_path": { "type": "string" }
            }
          },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rejected_ideas": {
      "type": "array",
      "description": "Ideas killed in debate, kept for trace honesty.",
      "items": {
        "type": "object",
        "required": ["statement", "reason"],
        "properties": {
          "statement": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "ranking_evidence": {
      "type": "object",
      "description": "Aggregation output (e.g. Elo ratings) that produced the shortlist."
    }
  }
}
