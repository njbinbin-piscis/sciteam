{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/research_plan.schema.json",
  "title": "ResearchPlan",
  "description": "Exit contract for a Planning Council mission: a problem choice plus a mission DAG that the AdaptiveCampaignPlanner executes. The plan is policy; the engine never branches on its content.",
  "type": "object",
  "required": ["mission_id", "problem_choice", "missions"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "problem_choice": {
      "type": "object",
      "required": ["chosen_problem_id", "rationale"],
      "additionalProperties": false,
      "properties": {
        "chosen_problem_id": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 10 },
        "grounding_citation_keys": { "type": "array", "items": { "type": "string" } },
        "scores": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "falsification"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 10 },
          "falsification": { "type": "string", "minLength": 10 },
          "grounding_citation_keys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mission"],
        "additionalProperties": false,
        "properties": {
          "deps": { "type": "array", "items": { "type": "string" } },
          "on_fail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string", "enum": ["retry", "reenter", "continue", "abort"] },
              "target": { "type": "string" },
              "max_times": { "type": "integer", "minimum": 1 }
            }
          },
          "mission": {
            "type": "object",
            "required": ["id", "goal", "paradigm", "exit_contract"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string" },
              "goal": { "type": "string", "minLength": 5 },
              "paradigm": { "type": "string", "minLength": 1 },
              "exit_contract": { "type": "string", "minLength": 1 },
              "skills_allowlist": { "type": "array", "items": { "type": "string" } },
              "budget": { "type": "object" },
              "metadata": { "type": "object" }
            }
          }
        }
      }
    },
    "locked_ids": {
      "type": "array",
      "description": "Mission ids that a revision may never replace or remove (frozen endpoints, sealed-holdout audit, statistical budget).",
      "items": { "type": "string" }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "fallback": { "type": "string" },
    "citations": {
      "type": "array",
      "description": "Structured, resolvable-identifier record for any paper named directly in the plan (beyond a bare grounding_citation_keys reference into an upstream lit_map). Free-text mentions are not machine-checkable.",
      "items": {
        "type": "object",
        "required": ["claim"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "citation_key": { "type": "string" },
          "arxiv_id": { "type": "string" },
          "doi": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_missions": { "type": "integer", "minimum": 0 },
        "max_wall_clock_seconds": { "type": "integer", "minimum": 0 },
        "max_llm_tokens": { "type": "integer", "minimum": 0 },
        "max_revisions": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
