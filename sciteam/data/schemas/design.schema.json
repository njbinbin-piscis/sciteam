{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/design.schema.json",
  "title": "DesignSpec",
  "description": "Exit contract for design missions: an implementable algorithm design with an ablation plan.",
  "type": "object",
  "required": ["mission_id", "hypothesis_id", "design_id", "summary", "components", "ablation_plan"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "design_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 30 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "change", "expected_effect"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 10 },
          "expected_effect": { "type": "string", "minLength": 5 },
          "complexity_note": { "type": "string" }
        }
      }
    },
    "interface_compliance": {
      "type": "string",
      "description": "How the design fits the frozen eval interface (build_index/search, Policy, Scheduler...)."
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "default"],
        "properties": {
          "name": { "type": "string" },
          "default": {},
          "sweep": { "type": "array" }
        }
      }
    },
    "ablation_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ablation_id", "removes", "question"],
        "additionalProperties": false,
        "properties": {
          "ablation_id": { "type": "string" },
          "removes": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "debate_evidence": {
      "type": "object",
      "description": "Aggregation output that selected this design among alternatives."
    }
  }
}
