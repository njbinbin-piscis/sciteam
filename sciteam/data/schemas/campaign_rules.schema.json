{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/campaign_rules.schema.json",
  "title": "CampaignRules",
  "description": "L-layer legislation for one campaign. Must not contradict GRUNDNORM.",
  "type": "object",
  "required": [
    "mission_id",
    "campaign_id",
    "grundnorm_ref",
    "allowed",
    "forbidden",
    "audit_matrix",
    "scoring",
    "authors",
    "enacted_at"
  ],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "grundnorm_ref": {
      "type": "string",
      "description": "Path to frozen grundnorm asset",
      "minLength": 1
    },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "best_practices": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audit_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_kind", "audits"],
        "additionalProperties": false,
        "properties": {
          "artifact_kind": { "type": "string" },
          "audits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["schema", "ledger_align", "citation", "verifier_owned"]
            }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["mode", "penalties", "bonuses"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["record_only", "soft", "hard"]
        },
        "penalties": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "bonuses": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "red_team": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["no_veto", "veto_with_reasons"]
        },
        "notes": { "type": "string" }
      }
    },
    "enacted_at": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
