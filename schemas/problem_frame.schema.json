{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/problem_frame.schema.json",
  "title": "ProblemFrame",
  "description": "Domain-agnostic framing of an operator goal: what the team will pursue, what is machine-verifiable in this sandbox, and what requires external labs.",
  "type": "object",
  "required": [
    "mission_id",
    "operator_goal",
    "reframed_problem",
    "domain_label",
    "success_criteria",
    "machine_verifiable_in_sandbox",
    "requires_external_resources",
    "honesty_note"
  ],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "operator_goal": { "type": "string", "minLength": 10 },
    "reframed_problem": { "type": "string", "minLength": 30 },
    "domain_label": { "type": "string", "minLength": 2 },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "machine_verifiable_in_sandbox": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires_external_resources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proposed_proxy_eval": { "type": "string" },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "honesty_note": { "type": "string", "minLength": 20 }
  }
}
