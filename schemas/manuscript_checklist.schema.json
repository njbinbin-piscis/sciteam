{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/manuscript_checklist.schema.json",
  "title": "ManuscriptChecklist",
  "description": "Exit contract for write missions: manuscript exists and every critical checklist item passes.",
  "type": "object",
  "required": ["mission_id", "manuscript_path", "items"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "manuscript_path": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "description", "critical", "status"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string" },
          "description": { "type": "string" },
          "critical": { "type": "boolean" },
          "status": { "type": "string", "enum": ["pass", "fail", "n/a"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "claim_result_map": {
      "type": "array",
      "description": "Every quantitative claim in the manuscript keyed to a frozen result id.",
      "items": {
        "type": "object",
        "required": ["claim_id", "result_id"],
        "properties": {
          "claim_id": { "type": "string" },
          "result_id": { "type": "string" },
          "location": { "type": "string" }
        }
      }
    },
    "citation_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "resolvable": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "array", "items": { "type": "string" } },
        "entries": {
          "type": "array",
          "description": "Structured, resolvable-identifier record backing `total`/`resolvable` — the summary counts alone are not machine-checkable; a declared artifact_audit runs against this list.",
          "items": {
            "type": "object",
            "required": ["claim"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string" },
              "citation_key": { "type": "string" },
              "arxiv_id": { "type": "string" },
              "doi": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
