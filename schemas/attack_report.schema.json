{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/attack_report.schema.json",
  "title": "AttackReport",
  "description": "Exit contract for adversarial missions: documented attacks on the current claims before promote-to-write.",
  "type": "object",
  "required": ["mission_id", "target_claims", "attacks", "verdict"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "target_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement"],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" }
        }
      }
    },
    "attacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attack_id", "vector", "method", "outcome"],
        "additionalProperties": false,
        "properties": {
          "attack_id": { "type": "string" },
          "vector": {
            "type": "string",
            "description": "e.g. seed sensitivity, workload shift, baseline mistuning, metric gaming, implementation bug"
          },
          "method": { "type": "string", "minLength": 10 },
          "outcome": {
            "type": "string",
            "enum": ["survived", "weakened", "falsified", "inconclusive"]
          },
          "evidence_path": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["promote", "revise", "falsified"],
      "description": "promote = claims survive; revise = claims need weakening; falsified = back to planner."
    },
    "required_revisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "description": "Structured, resolvable-identifier record of every named paper (e.g. a known negative result cited as an attack vector). Free-text mentions inside attacks[].method/notes are not machine-checkable.",
      "items": {
        "type": "object",
        "required": ["claim"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "citation_key": { "type": "string" },
          "arxiv_id": { "type": "string" },
          "doi": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
