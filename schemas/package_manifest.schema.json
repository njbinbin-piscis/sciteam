{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciteam/package_manifest.schema.json",
  "title": "PackageManifest",
  "description": "Exit contract for package/wrap_up missions: the evidence bundle is complete (or honestly partial).",
  "type": "object",
  "required": ["mission_id", "campaign_id", "outcome", "contents"],
  "additionalProperties": false,
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "outcome": {
      "type": "string",
      "enum": ["positive", "negative", "partial"],
      "description": "Honest label; negative/partial results are legitimate deliverables."
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "description": "e.g. protocol, playbook, mission_trace, paradigms_used, engine_diff_stat, three_questions, results, manuscript, arm"
          },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "missing": {
      "type": "array",
      "description": "Declared gaps when outcome is partial.",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" }
  }
}
